apiVersion: apps/v1
kind: Deployment
metadata:
  name: museum-core
  namespace: museum
spec:
  replicas: 2
  selector:
    matchLabels:
      app: museum-core
  template:
    metadata:
      labels:
        app: museum-core
    spec:
      containers:
        - name: core
          image: localhost:5001/museum-core:__IMAGE_TAG__
          imagePullPolicy: Always
          env:
            - name: DATABASE_PATH
              value: /data/museum.db
            - name: INIT_DATABASE
              value: "0"
          ports:
            - containerPort: 8000
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: museum-core-data
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: museum-users
  namespace: museum
spec:
  replicas: 2
  selector:
    matchLabels:
      app: museum-users
  template:
    metadata:
      labels:
        app: museum-users
    spec:
      containers:
        - name: users
          image: localhost:5001/museum-users:__IMAGE_TAG__
          imagePullPolicy: Always
          env:
            - name: USERS_DATABASE_PATH
              value: /data/users.db
            - name: INIT_DATABASE
              value: "0"
          ports:
            - containerPort: 8000
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /data
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: museum-users-data
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: museum-web
  namespace: museum
spec:
  replicas: 2
  selector:
    matchLabels:
      app: museum-web
  template:
    metadata:
      labels:
        app: museum-web
    spec:
      containers:
        - name: nginx
          image: public.ecr.aws/docker/library/nginx:stable-alpine
          ports:
            - containerPort: 80
          readinessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 10
          volumeMounts:
            - name: nginx-config
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
              readOnly: true
      volumes:
        - name: nginx-config
          configMap:
            name: museum-nginx
